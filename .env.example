# Anthropic — intake conversation + final extraction
ANTHROPIC_API_KEY=

# Resend — transactional email for the team notification and lead confirmation
RESEND_API_KEY=
FROM_EMAIL=Traq Collective <hello@traqcollective.com>
TEAM_INTAKE_EMAIL=hello@traqcollective.com

# Cloudflare Turnstile — bot/abuse protection on the chat
# The site key is exposed to the browser; the secret key stays server-side.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Upstash Redis — per-IP rate limiting for /api/intake/*
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Analytics 4 — measurement id, inlined at build time (needs a redeploy)
NEXT_PUBLIC_GA_ID=

# Google Ads tag — "AW-XXXXXXXXX". Optional and separate from GA4: it enables
# enhanced conversions and same-day conversion reporting, neither of which the
# GA4 import path can do. Also inlined at build time, so set it then redeploy.
NEXT_PUBLIC_GADS_ID=

# Lead sheet — the Apps Script web app URL, with its ?token=... appended.
# Every intake route appends a row here so the gclid survives the click and can
# be uploaded to Google Ads as an offline conversion months later. Server-side
# only. See docs/2026-08-28-lead-sheet-setup.md.
LEAD_SHEET_WEBHOOK_URL=
